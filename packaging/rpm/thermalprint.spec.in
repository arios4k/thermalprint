# Generated by scripts/prepare-rpm.py from Cargo.toml and the locked dependencies.
# This Copr package vendors crates so the actual RPM build needs no network.
%global debug_package %{nil}

Name:           thermalprint
Version:        @VERSION@
Release:        1%{?dist}
Summary:        Design, prepare, and print thermal labels
License:        @LICENSE@
URL:            https://github.com/arios4k/thermalprint
Source0:        %{name}-%{version}.tar.xz

BuildRequires:  cargo >= 1.96
BuildRequires:  rust >= 1.96
BuildRequires:  gcc
BuildRequires:  gcc-c++
BuildRequires:  pkgconf-pkg-config
BuildRequires:  pkgconfig(openssl)
BuildRequires:  desktop-file-utils
Requires:       shared-mime-info
Requires:       desktop-file-utils
Requires:       cups-client
Requires:       poppler-utils
Requires:       libX11
Requires:       libXcursor
Requires:       libXi
Requires:       libXrandr
Requires:       libxkbcommon
Requires:       libxkbcommon-x11
Requires:       libwayland-client
Requires:       libwayland-cursor
Requires:       libwayland-egl
Requires:       libglvnd-egl
Requires:       libglvnd-glx
Recommends:     mesa-dri-drivers
Recommends:     xdg-desktop-portal

# Dependency versions bundled into the source archive (including target-specific crates).
@BUNDLED_PROVIDES@

%description
ThermalPrint designs custom labels with text, shapes, barcodes, and QR codes.
It also imports PDF and image labels, crops and previews them, and submits
print jobs through CUPS. All document processing takes place locally.

%prep
%setup -q

%build
export CARGO_HOME="$PWD/.cargo-home"
export CARGO_BUILD_JOBS=%{_smp_build_ncpus}
export RUSTFLAGS="%{?build_rustflags}"
cargo build --release --frozen

%install
install -Dpm0644 data/org.thermalprint.ThermalPrint.xml %{buildroot}%{_datadir}/mime/packages/org.thermalprint.ThermalPrint.xml
install -Dpm0755 target/release/thermalprint %{buildroot}%{_bindir}/thermalprint
install -Dpm0644 data/org.thermalprint.ThermalPrint.desktop %{buildroot}%{_datadir}/applications/org.thermalprint.ThermalPrint.desktop
install -Dpm0644 data/org.thermalprint.ThermalPrint.metainfo.xml %{buildroot}%{_metainfodir}/org.thermalprint.ThermalPrint.metainfo.xml
install -Dpm0644 data/org.thermalprint.ThermalPrint.svg %{buildroot}%{_datadir}/icons/hicolor/scalable/apps/org.thermalprint.ThermalPrint.svg
install -Dpm0644 data/org.thermalprint.ThermalPrint.png %{buildroot}%{_datadir}/icons/hicolor/256x256/apps/org.thermalprint.ThermalPrint.png

%check
export CARGO_HOME="$PWD/.cargo-home"
export CARGO_BUILD_JOBS=%{_smp_build_ncpus}
export RUSTFLAGS="%{?build_rustflags}"
cargo test --release --frozen
desktop-file-validate %{buildroot}%{_datadir}/applications/org.thermalprint.ThermalPrint.desktop

%files
%license LICENSE assets/fonts/LICENSE.txt VENDORED-LICENSES.txt vendor-licenses/
%doc README.md
%{_bindir}/thermalprint
%{_datadir}/applications/org.thermalprint.ThermalPrint.desktop
%{_datadir}/mime/packages/org.thermalprint.ThermalPrint.xml
%{_metainfodir}/org.thermalprint.ThermalPrint.metainfo.xml
%{_datadir}/icons/hicolor/scalable/apps/org.thermalprint.ThermalPrint.svg
%{_datadir}/icons/hicolor/256x256/apps/org.thermalprint.ThermalPrint.png

%changelog
* Fri Nov 06 2026 Alexis Rios-Negron <arios4k@gmail.com> - @VERSION@-1
- Add free-angle mouse rotation and precise fractional angles.
- Register saved label files and protect unsaved designs when replacing or closing.
- Refine navigation rows, the save prompt, and the non-scrolling About dialog.
