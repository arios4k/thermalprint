[Desktop Entry]
Type=Application
Name=ThermalPrint
Comment=Prepare shipping labels for thermal printers
Exec=thermalprint %f
Terminal=false
Icon=org.thermalprint.ThermalPrint
StartupWMClass=org.thermalprint.ThermalPrint
